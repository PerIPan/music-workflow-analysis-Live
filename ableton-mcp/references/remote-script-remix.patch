+    def _add_warp_marker(self, track_index, clip_index, beat_time, sample_time=None):
+        """Add a warp marker (Clip.add_warp_marker with a Live.Clip.WarpMarker, as MxDCore
+        does). sample_time is in seconds; omitted, it keeps the clip's timing (as MxDCore:
+        beat_to_sample_time gives samples)."""
+        clip = self._warped_audio_clip(track_index, clip_index)
+        beat_time = float(beat_time)
+        if sample_time is None:
+            sample_time = clip.beat_to_sample_time(beat_time) / float(clip.sample_rate)
+        sample_time = float(sample_time)
+        length_s = clip.sample_length / float(clip.sample_rate)
+        if not 0.0 <= sample_time <= length_s:
+            raise ValueError("sample_time {0} s outside the sample (0-{1:.3f} s)".format(
+                sample_time, length_s))
+        clip.add_warp_marker(Live.Clip.WarpMarker(beat_time=beat_time, sample_time=sample_time))
+        added = [m for m in clip.warp_markers if abs(m.beat_time - beat_time) < 1e-3]
+        if not added:
+            raise RuntimeError("Live did not add the warp marker at beat {0} (sample time must lie "
+                               "between its neighbours' and each segment within 5-999 BPM)".format(beat_time))
+        return {"beat_time": beat_time, "sample_time": added[0].sample_time,
+                "count": len(list(clip.warp_markers))}
+
+    def _move_warp_marker(self, track_index, clip_index, beat_time, distance):
+        """Move the warp marker at beat_time by distance beats (Clip.move_warp_marker)"""
+        clip = self._warped_audio_clip(track_index, clip_index)
+        beat_time, distance = float(beat_time), float(distance)
+        if not any(abs(m.beat_time - beat_time) < 1e-3 for m in clip.warp_markers):
+            raise ValueError("No warp marker at beat {0}".format(beat_time))
+        clip.move_warp_marker(beat_time, distance)
+        target = beat_time + distance
+        if not any(abs(m.beat_time - target) < 1e-3 for m in clip.warp_markers):
+            raise RuntimeError("Live did not move the warp marker to beat {0}".format(target))
+        return {"beat_time": target}
+
+    def _set_clip_warping(self, track_index, clip_index, warping):
+        """Switch Warp on/off. Live defers this: read it back with get_clip_info."""
+        clip_slot = self._validate_clip_slot(track_index, clip_index)
+        if not clip_slot.has_clip or not clip_slot.clip.is_audio_clip:
+            raise ValueError("No audio clip in slot")
+        clip_slot.clip.warping = bool(warping)
+        return {"warping_requested": bool(warping)}
+
+    def _create_audio_clip(self, track_index, clip_index, file_path, name=None):
+        """Load an audio file into an empty Session slot (ClipSlot.create_audio_clip, Live 12)"""
+        clip_slot = self._validate_clip_slot(track_index, clip_index)
+        track = self._song.tracks[track_index]
+        if not track.has_audio_input:
+            raise ValueError("Track {0} is not an audio track".format(track_index))
+        if getattr(track, "is_frozen", False):
+            raise ValueError("Track {0} is frozen".format(track_index))
+        if clip_slot.has_clip:
+            raise ValueError("Clip slot already has a clip")
+        file_path = str(file_path)
+        if not os.path.isabs(file_path) or not os.path.isfile(file_path):
+            raise ValueError("Not an existing absolute file path: {0}".format(file_path))
+        if not file_path.lower().endswith(AUDIO_FILE_EXTS):
+            raise ValueError("Not an audio file ({0}): {1}".format(", ".join(AUDIO_FILE_EXTS), file_path))
+        if not hasattr(clip_slot, "create_audio_clip"):
+            raise RuntimeError("ClipSlot.create_audio_clip is not in this Live version (needs Live 12)")
+        clip_slot.create_audio_clip(file_path)
+        if not clip_slot.has_clip:
+            raise RuntimeError("Live did not create the audio clip")
+        clip = clip_slot.clip
+        if name:
+            clip.name = name
+        return {"track_index": track_index, "clip_index": clip_index, "name": clip.name,
+                "file_path": getattr(clip, "file_path", file_path),
+                "sample_rate": clip.sample_rate, "sample_length": clip.sample_length,
+                "warping": clip.warping}
 
     def _delete_warp_marker(self, track_index, clip_index, beat_time):
         """Delete a warp marker from an audio clip by beat time"""
